{
  "name": "ai-ui-automation-explore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.12.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-e1-demo.mjs",
    "dev:blind-eval": "node scripts/start-e1-demo.mjs --blind-eval",
    "dev:m1": "node scripts/start-m1-demo.mjs",
    "dev:s1": "node scripts/start-s1-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=ui",
    "test": "npm run typecheck && npm run test:unit && npm run test:api && npm run test:e2e && npm run test:m1:api && npm run test:m1:e2e && npm run test:s1:api && npm run test:s1:e2e",
    "demo:reset": "node scripts/reset-e1-run.mjs",
    "test:m1:api": "playwright test --config=playwright.m1.config.ts --project=api",
    "test:m1:e2e": "playwright test --config=playwright.m1.config.ts --project=ui",
    "test:m1": "npm run typecheck && npm run test:m1:api && npm run test:m1:e2e",
    "test:s1:api": "playwright test --config=playwright.s1.config.ts --project=api",
    "test:s1:e2e": "playwright test --config=playwright.s1.config.ts --project=ui",
    "test:s1": "npm run typecheck && npm run test:s1:api && npm run test:s1:e2e",
    "p4:dry-run": "node experiments/p4-visual-dry-run/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^26.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
