{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/exploration-charter.schema.json",
  "title": "Exploration Charter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "case_id",
    "allowed_origin",
    "allowed_paths",
    "account_role",
    "budget",
    "allowed_actions",
    "oracles",
    "stop_conditions"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 3
    },
    "case_id": {
      "enum": [
        "E1",
        "M1",
        "S1"
      ]
    },
    "allowed_origin": {
      "type": "string",
      "pattern": "^http://(127\\.0\\.0\\.1|localhost)(:[0-9]{2,5})?$"
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?![/\\\\])"
      }
    },
    "account_role": {
      "type": "string",
      "minLength": 3
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "max_duration_seconds",
        "max_writes"
      ],
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_writes": {
          "description": "Budget for writes listed by the case contract; transient run-local cart selection and quote creation do not count.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "observe",
          "click_safe",
          "type_synthetic",
          "navigate_allowed",
          "refresh",
          "read_oracle",
          "sandbox_write_approved"
        ]
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "required_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "screenshot",
          "trace",
          "network_redacted",
          "oracle_result",
          "action_log"
        ]
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "scope_violation",
          "unauthorized_write",
          "exhausted_budget",
          "missing_oracle",
          "tool_error",
          "unknown_write_result"
        ]
      }
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "budget": {
            "properties": {
              "max_writes": {
                "minimum": 1
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "approval_ref"
        ],
        "properties": {
          "approval_ref": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowed_actions": {
            "contains": {
              "const": "sandbox_write_approved"
            }
          }
        }
      },
      "then": {
        "required": [
          "approval_ref"
        ],
        "properties": {
          "approval_ref": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  ]
}
