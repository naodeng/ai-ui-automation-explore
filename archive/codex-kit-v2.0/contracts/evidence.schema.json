{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence.schema.json",
  "title": "Evidence Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "run_id",
    "case_id",
    "kind",
    "producer",
    "captured_at",
    "path",
    "sha256",
    "redaction_status",
    "classification"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 3
    },
    "run_id": {
      "type": "string",
      "minLength": 5
    },
    "case_id": {
      "enum": [
        "E1",
        "M1",
        "S1"
      ]
    },
    "kind": {
      "enum": [
        "screenshot",
        "browser_trace",
        "network_summary",
        "oracle_response",
        "action_log",
        "test_result"
      ]
    },
    "producer": {
      "type": "string",
      "minLength": 2
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "path": {
      "type": "string",
      "minLength": 3
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "redaction_status": {
      "enum": [
        "redacted",
        "synthetic_only",
        "review_required"
      ]
    },
    "classification": {
      "enum": [
        "public_synthetic",
        "internal_test",
        "restricted"
      ]
    },
    "rule_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
