{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "demos/ecommerce-checkout/src/**/*.ts",
    "demos/membership-lifecycle/src/**/*.ts",
    "demos/flash-sale/src/server.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "playwright.m1.config.ts",
    "playwright.s1.config.ts"
  ]
}
